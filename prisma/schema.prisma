generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Tour {
  // ID interno canônico da PMY. Este é o "passaporte" mestre do passeio.
  id                     String        @id @default(uuid())
  title                  String
  productType            String?
  shopifyStatus          String?

  // IDs do mesmo passeio em cada canal.
  shopifyProductId       String?       @unique
  gygActivityId          String?       @unique
  viatorProductCode      String?       @unique
  headoutId              String?       @unique
  civitatisId            String?       @unique
  tripadvisorProductCode String?       @unique
  airbnbExperienceId     String?       @unique

  variants               TourVariant[]
  bookings               Booking[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt

  @@index([title])
  @@index([productType])
}

model TourVariant {
  // Variante interna ligada ao Tour mestre. Mantém IDs de opções/variantes por canal.
  id                String   @id @default(uuid())
  tourId            String
  tour              Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  shopifyVariantId  String?  @unique
  gygOptionId       String?  @unique
  viatorOptionCode  String?  @unique
  headoutVariantId  String?  @unique
  civitatisOptionId String?  @unique

  title             String?
  sku               String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([tourId])
  @@index([sku])
}

model Booking {
  id                  String    @id @default(uuid())
  tourId              String
  tour                Tour      @relation(fields: [tourId], references: [id])
  customerName        String
  customerEmail       String?
  customerPhone       String?
  language            String?
  startTime           DateTime
  platform            String
  status              String    @default("CONFIRMED")

  // Referências externas e idempotência multicanal
  bookingRef          String?
  externalBookingId   String?
  externalProductId   String?
  externalVariantId   String?

  // Composição de passageiros
  adults              Int       @default(0)
  children            Int       @default(0)
  youths              Int       @default(0)
  seniors             Int       @default(0)
  totalParticipants   Int       @default(0)

  // Dados financeiros e voucher
  totalPrice          Decimal?  @db.Decimal(12, 2)
  currency            String?   @db.VarChar(3)
  voucherCode         String?
  voucherFormat       String?

  // Sincronização / auditoria
  syncStatus          String    @default("PENDING")
  lastSyncedAt        DateTime?
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  holdExpiresAt       DateTime?
  cancelReason        String?
  rawPayload          Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@unique([platform, externalBookingId], map: "Booking_platform_externalBookingId_key")
  @@index([bookingRef])
  @@index([tourId, startTime])
  @@index([platform, status])
}

model Guide {
  id           String   @id @default(uuid())
  name         String
  email        String?
  whatsapp     String
  photoUrl     String?
  utmId        String?  // ID da campanha UTM (ex: 21d91c)
  referralLink String?  // Link completo com parâmetros UTM
  createdAt    DateTime @default(now())
}

model BlockedDate {
  id        String    @id @default(uuid())
  tourId    String?
  date      DateTime?
  dayOfWeek String?
  timeSlot  String?
  createdAt DateTime  @default(now())
}

model Media {
  id        String   @id @default(uuid())
  url       String
  filename  String
  mimetype  String
  category  String   @default("general")
  label     String?
  createdAt DateTime @default(now())
}

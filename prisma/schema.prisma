generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


model AppTenantLock {
  key       String   @id @default("PRIMARY")
  shop      String   @unique
  source    String   @default("AUTO")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shop])
}

// Pessoas da equipe que abrem a Central pelo admin do Shopify.
// Identificadas pelo ID do usuário Shopify (sessionToken.sub).
// ADMIN vê tudo; STAFF não vê Financeiro, Desempenho, Saúde das integrações,
// Integrações e Configurações.
model CentralUser {
  id            String   @id @default(uuid())
  shopifyUserId String   @unique
  name          String?
  role          String   @default("STAFF")
  // Pessoa da Equipe (cadastro em Guide) dona deste acesso.
  guideId       String?  @unique
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

// Cotações do Banco Central Europeu (via Frankfurter), 1 unidade da moeda = rateToEur euros.
model FxRate {
  id        String   @id @default(uuid())
  date      String   @db.VarChar(10)
  currency  String   @db.VarChar(3)
  rateToEur Decimal  @db.Decimal(14, 8)
  createdAt DateTime @default(now())

  @@unique([date, currency])
}

// Uma saída = um passeio num dia e horário (o "cartão" do Trello).
// Guarda o que é da saída e não do passeio: etiquetas hoje; checklist,
// check-ins do guia e anexos na Fase 2.
model TourDeparture {
  id           String   @id @default(uuid())
  tourId       String
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startTime    DateTime
  tagIds       String[] @default([])
  // Checklist do guia: só a gestão pode desfazer.
  checkStartAt DateTime?
  checkMidAt   DateTime?
  checkEndAt   DateTime?
  checkedBy    String?
  // Observações: lista só-adiciona [{ at, by, text }].
  guideNotes   Json?
  // Checklists do cartão no Quadro: { lists: [{ id, title, items: [{ id, text, done, at, by }] }], auto: { [itemKey]: { done, at, by } }, hideDone: { [listId]: true } }
  checklists   Json?
  attachments  DepartureAttachment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([tourId, startTime])
  @@index([startTime])
}

// Ingressos e outros arquivos da saída, visíveis para o guia escalado.
model DepartureAttachment {
  id          String        @id @default(uuid())
  departureId String
  departure   TourDeparture @relation(fields: [departureId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  uploadedBy  String?
  createdAt   DateTime      @default(now())

  @@index([departureId])
}

// Coluna fixa "Documentos de suporte" do Quadro (passes, vouchers, instruções
// do cacifo, mensagens-modelo...). Veio do Trello; guias veem e baixam os anexos.
model SupportCard {
  id              String                  @id @default(uuid())
  title           String
  body            String?                 @db.Text
  // [{ name, url }] — links (inclusive anexos que ficaram no Trello)
  links           Json?
  // [{ title, items: [{ text, done }] }]
  checklists      Json?
  position        Int                     @default(0)
  visibleToGuides Boolean                 @default(true)
  // Demanda avulsa no Quadro (sem passeio): com dia, aparece na coluna do dia;
  // sem dia, é documento de suporte (coluna fixa).
  dateKey         String?
  time            String?
  assigneeIds     String[]                @default([])
  done            Boolean                 @default(false)
  trelloId        String?                 @unique
  attachments     SupportCardAttachment[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  @@index([position])
  @@index([dateKey])
}

model SupportCardAttachment {
  id         String      @id @default(uuid())
  cardId     String
  card       SupportCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime    @default(now())

  @@index([cardId])
}

// Comentários e atividade dos cartões do Quadro (como no Trello): quem fez o
// quê e comentários com @menção. targetType "departure" → targetKey
// "tourId|ISO" da saída; "card" → id do SupportCard (demanda/documento).
model BoardActivity {
  id             String   @id @default(uuid())
  targetType     String
  targetKey      String
  kind           String   @default("event")
  text           String   @db.Text
  authorName     String?
  authorPersonId String?
  mentionIds     String[] @default([])
  readBy         String[] @default([])
  createdAt      DateTime @default(now())

  @@index([targetType, targetKey, createdAt])
  @@index([createdAt])
}

model GuideSession {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([guideId])
}

model Tour {
  // ID interno canônico da PMY. Este é o "passaporte" mestre do passeio.
  id                     String        @id @default(uuid())
  title                  String
  productType            String?
  shopifyStatus          String?
  shopifySnapshot        Json?
  maxCapacity            Int           @default(20)
  platformCapacityLimits Json?
  // Vagas liberadas por idioma em cada saída. Ver app/utils/language-quotas.js.
  languageSlotQuotas     Json?
  capacitySource         String        @default("DEFAULT")
  scheduleSlots          String[]      @default([])
  scheduleSource         String        @default("UNCONFIGURED")
  timezone               String        @default("Europe/Lisbon")
  bookingCutoffSeconds   Int?
  durationMinutes        Int?
  durationSource         String        @default("UNCONFIGURED")
  gygPriceOverApi        Boolean       @default(false)

  // IDs do mesmo passeio em cada canal.
  shopifyProductId       String?       @unique
  gygActivityId          String?       @unique
  viatorProductCode      String?       @unique
  headoutId              String?       @unique
  civitatisId            String?       @unique
  tripadvisorProductCode String?       @unique
  airbnbExperienceId     String?       @unique

  variants               TourVariant[]
  gygProductOptions       GygProductOption[]
  bookings               Booking[]
  blockedDates           BlockedDate[]
  guideAssignments       GuideAssignment[]
  departures             TourDeparture[]
  waitlist               WaitlistEntry[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt

  @@index([title])
  @@index([productType])
}

model TourVariant {
  // Variante interna ligada ao Tour mestre. Mantém IDs de opções/variantes por canal.
  id                String   @id @default(uuid())
  tourId            String
  tour              Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  shopifyVariantId  String?  @unique
  gygOptionId       String?  @unique // legado; novo mapeamento vive em GygProductOption
  gygProductOptionId String?
  gygProductOption   GygProductOption? @relation(fields: [gygProductOptionId], references: [id], onDelete: SetNull)
  viatorOptionCode  String?  @unique
  headoutVariantId  String?  @unique
  civitatisOptionId String?  @unique

  title             String?
  sku               String?
  passengerCategory String?
  startTimeSlot     String?
  price             Decimal? @db.Decimal(12, 2)
  currency          String?  @db.VarChar(3)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([tourId])
  @@index([sku])
  @@index([passengerCategory])
  @@index([startTimeSlot])
  @@index([gygProductOptionId])
}

model GygProductOption {
  // Produto externo da PMY conectado a UMA opção vendável do GetYourGuide.
  // O próprio id é o supplier productId enviado ao Integrator Portal.
  id          String        @id @default(uuid())
  tourId      String
  tour        Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  optionKey   String
  title       String
  gygOptionId String?       @unique
  active      Boolean       @default(true)
  variants    TourVariant[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([tourId, optionKey])
  @@index([tourId])
  @@index([active])
}

model Booking {
  id                  String    @id @default(uuid())
  tourId              String
  tour                Tour      @relation(fields: [tourId], references: [id])
  customerName        String
  customerEmail       String?
  customerPhone       String?
  language            String?
  startTime           DateTime
  platform            String
  commercialSource    String    @default("Outro")
  status              String    @default("CONFIRMED")

  // Referências externas e idempotência multicanal
  bookingRef          String?
  externalBookingId   String?
  externalOrderId     String?
  externalLineItemIds String[]  @default([])
  externalProductId   String?
  externalVariantId   String?

  // Composição de passageiros
  adults              Int       @default(0)
  children            Int       @default(0)
  youths              Int       @default(0)
  seniors             Int       @default(0)
  totalParticipants   Int       @default(0)

  // Dados financeiros e voucher
  totalPrice          Decimal?  @db.Decimal(12, 2)
  currency            String?   @db.VarChar(3)
  // Valor em euro (cotação BCE do dia da reserva, guardada em fxRateToEur).
  // Toda a Central mostra/soma este campo. Ver app/utils/fx.server.js.
  totalPriceEur       Decimal?  @db.Decimal(12, 2)
  fxRateToEur         Decimal?  @db.Decimal(14, 8)
  fxRateDate          String?   @db.VarChar(10)
  voucherCode         String?
  voucherFormat       String?

  // Sincronização / auditoria
  syncStatus          String    @default("PENDING")
  lastSyncedAt        DateTime?
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  holdExpiresAt       DateTime?
  cancelReason        String?
  rawPayload          Json?

  // Realização do passeio, marcada pela equipe (e, na Fase 2, pelo guia).
  // Separado de "status" para que atualizações das plataformas não apaguem.
  // COMPLETED = realizado · NO_SHOW = cliente não compareceu · null = não marcado
  attendanceStatus    String?
  attendanceNote      String?   @db.Text
  attendanceMarkedAt  DateTime?
  attendanceMarkedBy  String?
  // Guia que gerou o link de pagamento pelo portal (item 7: vendas do guia).
  sellerGuideId       String?
  // Grupo da saída escolhido pela gestão (guia). Vazio = automático pelo idioma.
  groupGuideId        String?
  // Item 6 (opcional): participantes registrados pelo guia [{ name, country }].
  participants        Json?
  // Saída movida pela gestão no Quadro (arrastar o cartão para outra data).
  // Com movedAt preenchido, atualizações do pedido na Shopify não devolvem a data antiga.
  movedAt             DateTime?
  movedFromStartTime  DateTime?
  movedBy             String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@unique([platform, externalBookingId], map: "Booking_platform_externalBookingId_key")
  @@index([bookingRef])
  @@index([externalOrderId])
  @@index([tourId, startTime])
  @@index([platform, status])
  @@index([commercialSource])
  @@index([platform, externalOrderId])
  @@index([startTime])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([externalCreatedAt])
  @@index([externalUpdatedAt])
}

model Guide {
  id                  String            @id @default(uuid())
  name                String
  email               String?
  whatsapp            String
  photoUrl            String?
  photoMediaId        String?
  description         String?           @db.Text
  videoUrl            String?           @db.Text
  galleryUrls         String[]          @default([])
  exclusiveProducts   Json?
  shopifyMetaobjectId String?           @unique
  shopifyHandle       String?
  shopifyActive       Boolean           @default(false)
  shopifyUpdatedAt    DateTime?
  source              String            @default("CENTRAL")
  utmId               String?           // ID da campanha UTM (ex: 21d91c)
  referralLink        String?           // Link completo com parâmetros UTM
  // Portal do guia (Fase 2): login com e-mail + senha criada pela gestão.
  passwordHash        String?
  portalEnabled       Boolean           @default(false)
  lastLoginAt         DateTime?
  // Equipe: áreas da pessoa (GUIA, ADMIN, COMERCIAL, MARKETING, OPERACAO). Só GUIA aparece na escala.
  areas               String[]          @default(["GUIA"])
  sessions            GuideSession[]
  assignments         GuideAssignment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  @@index([shopifyHandle])
  @@index([shopifyActive])
  @@index([source])
  @@index([photoMediaId])
}

model GuideAssignment {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startTime DateTime
  // Idiomas do grupo deste guia (chaves canônicas: en, pt, es…). Vazio = todos.
  // Uma saída pode ter vários guias, um por grupo de idioma.
  languages String[] @default([])
  status    String   @default("ASSIGNED")
  source    String   @default("MANUAL")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([guideId, startTime])
  @@index([tourId, startTime])
  @@index([status, startTime])
}

model BlockedDate {
  id           String    @id @default(uuid())
  tourId       String?
  tour         Tour?     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date         DateTime?
  dayOfWeek    String?
  timeSlot     String?
  platforms    String[]  @default([])
  reason       String?
  source       String    @default("MANUAL")
  active       Boolean   @default(true)
  syncStatus   String    @default("PENDING")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([tourId, date])
  @@index([dayOfWeek])
  @@index([active])
}

model Media {
  id           String   @id @default(uuid())
  shop         String
  url          String   @db.Text
  filename     String
  mimetype     String
  category     String   @default("general")
  label        String?
  source       String   @default("pmy_upload")
  externalId   String
  productTitle String?
  width        Int?
  height       Int?
  metadata     Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([shop, source, externalId], map: "Media_shop_source_externalId_key")
  @@index([shop, active])
  @@index([shop, active, createdAt])
  @@index([source])
  @@index([category])
}


model IntegrationEvent {
  id              String   @id @default(uuid())
  provider        String
  externalEventId String
  topic           String
  shop            String?
  status          String   @default("RECEIVED")
  payload         Json?
  result          Json?
  error           String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([provider, externalEventId], map: "IntegrationEvent_provider_externalEventId_key")
  @@index([provider, topic])
  @@index([status])
}


model IntegrationSecret {
  id                   String   @id @default(uuid())
  provider             String   @unique
  status               String   @default("CONFIGURED")
  environment          String?
  credentialCiphertext String   @db.Text
  credentialIv         String
  credentialTag        String
  credentialKeyVersion String   @default("v1")
  credentialFingerprint String?
  metadata             Json?
  lastValidatedAt      DateTime?
  lastValidationStatus String?
  lastValidationMessage String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([environment])
}


model SyncEvent {
  id              String    @id @default(uuid())
  eventType       String
  sourcePlatform  String?
  aggregateType   String?
  aggregateId     String?
  tourId          String?
  bookingId       String?
  startTime       DateTime?
  scope           String    @default("SLOT")
  force           Boolean   @default(false)
  payload         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  jobs            SyncJob[]

  @@index([eventType, aggregateId])
  @@index([tourId, startTime])
  @@index([bookingId])
}

model SyncJob {
  id              String   @id @default(uuid())
  eventId         String
  event           SyncEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventType       String
  provider        String
  sourcePlatform  String?
  aggregateType   String?
  aggregateId     String?
  tourId          String?
  bookingId       String?
  startTime       DateTime?
  scope           String   @default("SLOT")
  force           Boolean  @default(false)
  payload         Json?

  status          String   @default("PENDING")
  attempts        Int      @default(0)
  maxAttempts     Int      @default(8)
  nextAttemptAt   DateTime @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  lastAttemptAt   DateTime?
  processedAt     DateTime?
  result          Json?
  error           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([provider, eventId], map: "SyncJob_provider_eventId_key")
  @@index([status, nextAttemptAt])
  @@index([eventType, aggregateId])
  @@index([tourId, startTime])
  @@index([bookingId])
}


model BusinessSetting {
  id             String   @id @default(uuid())
  shop           String   @unique
  logoUrl        String?  @db.Text // legado
  logoOnLightUrl     String?  @db.Text
  logoOnDarkUrl      String?  @db.Text
  logoOnLightMediaId String?
  logoOnDarkMediaId  String?
  theme              Json?
  imageShape     String   @default("rounded")
  fieldMappings  Json?
  // Cores por passeio e etiquetas da Agenda. Ver app/utils/agenda-labels.js.
  agendaLabels   Json?
  // Custos para faturamento × lucro. Ver app/utils/profit.js.
  costSettings   Json?
  // Preço por plataforma. Ver app/utils/platform-prices.js.
  platformPrices Json?
  // Funcionalidades opcionais ligadas/desligadas pelo administrador. Ver app/utils/feature-flags.js.
  featureFlags   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([shop])
}


model PlatformFieldMapping {
  id        String   @id @default(uuid())
  shop      String
  platform  String
  mappings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shop, platform], map: "PlatformFieldMapping_shop_platform_key")
  @@index([shop])
  @@index([platform])
}

// Persistent worker heartbeat shared across application processes.
model WorkerHeartbeat {
  name       String   @id
  lastSeenAt DateTime @default(now())
  lastOkAt   DateTime?
  lastError  String?
  updatedAt  DateTime @updatedAt
}

// Lista de espera de uma saída esgotada (passeio + data/hora).
// WAITING = na fila · NOTIFIED = avisado da vaga · BOOKED = reservou · REMOVED = saiu da fila
model WaitlistEntry {
  id            String    @id @default(uuid())
  tourId        String
  tour          Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startTime     DateTime
  customerName  String
  customerEmail String?
  customerPhone String?
  language      String?
  pax           Int       @default(1)
  notes         String?   @db.Text
  status        String    @default("WAITING")
  notifiedAt    DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([tourId, startTime])
  @@index([status, startTime])
}
